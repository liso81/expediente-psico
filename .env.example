# Copia este archivo como .env.local y cambia los valores.

# Clave de acceso a la aplicación (la que usará el psicólogo/a para entrar).
APP_PASSWORD=cambia-esta-clave

# Secreto usado para firmar la cookie de sesión. Pon cualquier cadena larga y aleatoria.
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio
